DATABASE_URL=postgres://facet:facet@127.0.0.1:5432/facet
# For authenticated provider APIs, set this to the same absolute local secret directory used by Control API.
FACET_SECRET_ROOT=
FACET_GATEWAY_PORT=4020
# Set to 1 only after facilitator and payer are funded and live /supported is verified.
FACET_DEMO_X402_ENABLED=0
FACET_FACILITATOR_URL=http://127.0.0.1:4022
# Must equal FACET_FACILITATOR_TOKEN in x402-facilitator/.env.
FACET_FACILITATOR_TOKEN=
FACET_EXECUTOR_URL=http://127.0.0.1:4030
# Must equal FACET_EXECUTOR_TOKEN in executor/.env.
FACET_EXECUTOR_TOKEN=
# TODO(T8): Update after deploying FacetFeeSplitAndEscrow v2 on Fuji
FACET_FEE_SPLIT_ADDRESS=0xc50cb5d5ff6c71eb1b065971c198a9edb0ecff06
FACET_RECEIPT_LOG_ADDRESS=0x5dc611b5642c306dd50fa7f786194dc04bd12fa7
FACET_CHAIN_ID=43113
# Optional stale escrow reconciler interval in ms (defaults to 60000 in runtime when omitted)
FACET_ESCROW_RECONCILE_INTERVAL_MS=60000
FACET_MAX_PAYMENT_ATOMIC=100000
FACET_DEMO_PAY_TO=
FACET_DEMO_AMOUNT_ATOMIC=1000
