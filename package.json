{
  "name": "@facet/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "smoke:upstream": "tsx scripts/upstream-smoke.ts",
    "db:smoke": "tsx scripts/local-db-smoke.ts",
    "db:smoke:paid": "FACET_PAID_SMOKE=1 tsx scripts/local-db-smoke.ts",
    "db:smoke:contract": "FACET_PAID_SMOKE=1 FACET_CONTRACT_SMOKE=1 tsx scripts/local-db-smoke.ts",
    "db:smoke:receipt-pending": "FACET_PAID_SMOKE=1 FACET_PENDING_RECEIPT_SMOKE=1 tsx scripts/local-db-smoke.ts",
    "db:smoke:multimodal": "tsx scripts/multimodal-db-smoke.ts",
    "db:smoke:fuji": "FACET_LIVE_FUJI_SMOKE=1 tsx scripts/multimodal-db-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src test scripts package.json tsconfig.json",
    "format:check": "prettier --check src test scripts package.json tsconfig.json",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@x402/core": "2.30.0",
    "ajv": "8.20.0",
    "fastify": "5.12.8",
    "ipaddr.js": "2.2.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
